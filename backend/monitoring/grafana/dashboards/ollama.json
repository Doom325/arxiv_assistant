{
  "title": "Ollama Performance",
  "uid": "ollama-metrics",
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "Active Requests",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "ollama_active_requests",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "rate(ollama_requests_total[1m])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Tokens / sec",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 15,
        "y": 0
      },
      "targets": [
        {
          "expr": "rate(ollama_tokens_total[1m])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Latency p95 (s)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ollama_request_latency_seconds_bucket[1m])) by (le, model))",
          "refId": "A",
          "legendFormat": "{{model}} p95"
        }
      ]
    },
    {
      "id": 5,
      "title": "Error Rate",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(ollama_requests_total{status='error'}[1m]))",
          "refId": "A"
        }
      ]
    }
  ]
}