# API Keys — copy this file to .env and fill in your actual keys
GEMINI_API_KEY=your-gemini-api-key-here
RESEND_API_KEY=your-resend-api-key-here

# Framework Desktop local LLM settings (optional — defaults in config.py)
# AI_PROVIDER=local
# EMBEDDING_PROVIDER=gemini
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_CHAT_MODEL=gemma3:27b
# OLLAMA_CLASSIFICATION_MODEL=gemma3:12b

# MCP Server credentials (used by Antigravity agent tools)
# PostgreSQL MCP — connects agent directly to the database
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/arxiv_assistant
# GitHub MCP — repo management, issues, PRs
# GITHUB_TOKEN=ghp_your-github-personal-access-token
# Context7 MCP — up-to-date library docs (optional, works without key at lower rate limits)
# CONTEXT7_API_KEY=your-context7-api-key
